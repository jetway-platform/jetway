# jetway.yaml — Flutter deployment config
# Run `jetway init` to generate this interactively.
# Docs: https://github.com/jetway-platform/jetway.git

app:
  name: "My Flutter App"
  bundle_id: "com.example.myapp"
  package_name: "com.example.myapp"
  # version: "1.2.0"                       # Optional: overrides pubspec.yaml version

ios:
  team_id: "ABCD1234EF"                    # Apple Developer Team ID
  profile: distribution                    # distribution | adhoc | development
  testflight_group: "Internal Testers"     # TestFlight group to add build to
  scheme: "Runner"                         # Xcode scheme (default: Runner)

  api_key_id: "ABC123DEF4"                 # App Store Connect Key ID
  api_issuer_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  api_key_path: "./keys/AuthKey_ABC123.p8"

android:
  keystore: "./keys/release.keystore"      # Path to release keystore
  # keystore_password: ""                  # Prefer env var: ANDROID_KEYSTORE_PASSWORD
  key_alias: "release"
  # key_password: ""                       # Prefer env var: ANDROID_KEY_PASSWORD
  track: internal                          # internal | alpha | beta | production
  artifact: aab                            # aab (recommended) | apk
  service_account: "./keys/play-service-account.json"
